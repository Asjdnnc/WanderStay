<%- layout("/layouts/boilerplate") -%> <!--navbar-->
<link rel="stylesheet" href="/css/style.css">
<style>
    .row a{
        text-decoration: none;
    }
</style><div id="filters">
  <a href="/wanderstay/listings/filter?category=Trending">
    <div class="filter">
      <div><i class="fa-solid fa-fire"></i></div>
      <p>Trending</p>
    </div>
  </a>
  <a href="/wanderstay/listings/filter?category=Rooms">
    <div class="filter">
      <div><i class="fa-solid fa-bed"></i></div>
      <p>Rooms</p>
    </div>
  </a>
  <a href="/wanderstay/listings/filter?category=Mountains">
    <div class="filter">
      <div><i class="fa-solid fa-mountain-sun"></i></div>
      <p>Mountains</p>
    </div>
  </a>
  <a href="/wanderstay/listings/filter?category=Iconic Cities">
    <div class="filter">
      <div><i class="fa-solid fa-mountain-city"></i></div>
      <p>Iconic Cities</p>
    </div>
  </a>

  <a href="/wanderstay/listings/filter?category=Castles">
    <div class="filter">
      <div><i class="fa-brands fa-fort-awesome"></i></div>
      <p>Castles</p>
    </div>
  </a>
  <a href="/wanderstay/listings/filter?category=Amazing pools">
    <div class="filter">
      <div><i class="fa-solid fa-person-swimming"></i></div>
      <p>Amazing pools</p>
    </div>
  </a>
  <a href="/wanderstay/listings/filter?category=Camping">
    <div class="filter">
      <div><i class="fa-solid fa-campground"></i></div>
      <p>Camping</p>
    </div>
  </a>
  <a href="/wanderstay/listings/filter?category=Farms">
    <div class="filter">
      <div><i class="fa-solid fa-tractor"></i></div>
      <p>Farms</p>
    </div>
  </a>
  <a href="/wanderstay/listings/filter?category=Arctic">
    <div class="filter">
      <div><i class="fa-solid fa-snowman"></i></div>
      <p>Arctic</p>
    </div>
  </a>
  <a href="/wanderstay/listings/filter?category=Dome">
    <div class="filter">
      <div><i class="fa-solid fa-igloo"></i></div>
      <p>Dome</p>
    </div>
  </a>
  <a href="/wanderstay/listings/filter?category=Boat">
    <div class="filter">
      <div><i class="fa-solid fa-ship"></i></div>
      <p>Boat</p>
    </div>
  </a>
  <div class="tax-toggle">
    <div class="form-check-reverse form-switch">
      <input
        class="form-check-input"
        type="checkbox"
        role="switch"
        id="flexSwitchCheckDefault"
      />
      <label class="form-check-label" for="flexSwitchCheckDefault">Display Taxes</label>
    </div>
  </div>
</div>
<br>
<h3>Category: <%=category%></h3><br>
<div class="row row-cols-lg-4 row-cols-md-2 row-cols-sm-1">
    <%for(let listing of listings){%>
        <a href="/wanderstay/listings/<%=listing._id%>">   
        <div class="card col listing-card">
            <div class="glass">
            <img src="<%= listing.image.url %>"
             class="card-img-top" 
             alt="listing_img" 
             style="height:15rem"> 
             <div class="card-img-overlay"></div>
            </div>
            <div class="card-body">
              <p id='listing-text2'><b><%= listing.title %></b>
                <br>
                &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
                <i class="tax-info">&nbsp +18% GST</i>
               </p>
            </div>
        </div>
        </a>
 <%}%>
</div> 
