# ==============================================================
# WanderStay — Environment Variables (example)
# Copy to `.env` and fill in real values. NEVER commit the real .env.
# ==============================================================

# --- Core App ---
PORT=8080
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# --- Database (MongoDB remains the source of truth) ---
MONGODB_URI=mongodb://127.0.0.1:27017/project

# --- Session ---
SECRET=thisshouldbeabettersecretergerwergv

# --- Maps ---
MAP_TOKEN=your_mapbox_token

# --- Cloudinary (image uploads) ---
CLOUD_NAME=your_cloud_name
CLOUD_API_KEY=your_cloud_api_key
CLOUD_API_SECRET=your_cloud_api_secret

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/google/callback

# --- Razorpay (test mode) ---
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ==============================================================
# AI FEATURES (Gemini + Qdrant) — server-side only, never exposed to React
# ==============================================================

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key

# Optional overrides (defaults shown)
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768

# Qdrant vector database
# Local (docker): http://localhost:6333  | Qdrant Cloud: https://xxxx.qdrant.io
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=wanderstay_listings
